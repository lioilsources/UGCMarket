# Vývoj na Macu (make api / make test). Kopie do .env, které není v gitu.
# Docker na Macu neběží: databáze market_dev a market_test jsou v market-db na JODĚ
# (deploy/db-init), port 5438 na LAN adrese JODY. Heslo = POSTGRES_PASSWORD z deploy/.env na JODĚ.
NAS=NAS_HOST
DEV_DATABASE_URL=postgres://market:PASSWORD@NAS_HOST:5438/market_dev?sslmode=disable
TEST_DATABASE_URL=postgres://market:PASSWORD@NAS_HOST:5438/market_test?sslmode=disable
# ingest jen čte (GET) z ugc-backend na JODĚ
UGC_URL=http://NAS_HOST:8095
ADMIN_EMAILS=admin@example.com
