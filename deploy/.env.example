# --- Úložiště na JODA: ZFS pool, dataset pool/market (snap docker vidí jen
# /home a /media, proto mountpoint pod /home jako pool-terra / pool-finetune) ---
#   sudo zfs create -o mountpoint=<home>/pool-market -o atime=off -o compression=lz4 pool/market
#   sudo zfs create -o recordsize=16K pool/market/postgres   # → pool-market/postgres
DATA_DIR=/path/to/pool-market
# Postgres pro vývoj z Macu (market_dev, market_test) jen na LAN adrese JODY, port 5438
DB_BIND=127.0.0.1
POSTGRES_PASSWORD=change-me

PUBLIC_URL=https://market.ol1n.com
# e-maily, které po přihlášení magic linkem vidí /admin (čárkou oddělené)
ADMIN_EMAILS=

# --- Ingest z UGC Factory ---
UGC_POLL_INTERVAL=5m
# jednotná cena nově ingestovaných assetů (centy USD); free pack se nastaví v adminu
DEFAULT_PRICE_CENTS=300

# --- LLM přes AiStack gateway na SPARKu (OpenAI-compatible) ---
# Prázdné = mock režim (chat i embeddingy fungují bez GPU, jen hůř).
# SPARK sdílí víc projektů — trvalé zapnutí domluvit přes spark-broker.
LLM_BASE_URL=
# LLM_BASE_URL=http://SPARK_HOST:8080/v1
LLM_MODEL=shop
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=shop-embed

# --- E-mail (magic link, potvrzení) přes Resend; prázdné = jen log ---
RESEND_API_KEY=
MAIL_FROM=Ol1n Market <market@ol1n.com>
