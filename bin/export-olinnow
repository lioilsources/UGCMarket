#!/usr/bin/env node
// Export the customer guide to the olin.now site (section `ugcmarket`, plan 02, stage 3b).
// Same source as /guide: web/src/lib/guide/guide.js rendered by render.js, in every language
// of the section. Translations: web/src/lib/guide/i18n/<lang>.json (keys from en.json).
//
//   bin/export-olinnow [path/to/ol1n.now]   # default ../ol1n.now next to this repo
//   bin/export-olinnow --update-en [path]   # after editing guide.js: rewrite en.json, then
//                                           # update the changed keys in every translation
//
// Writes apps/ugcmarket/pages/guide.html (site base language) and guide.<lang>.html, built
// into ugcmarket-guide[.<lang>].html with the usual language menu, and copies the screenshots
// to static/apps/ugcmarket/guide/. Only verified sections go out.
import { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { GUIDE } from '../web/src/lib/guide/guide.js';
import { applyStrings, guideStrings } from '../web/src/lib/guide/i18n.js';
import { inline, renderGuide } from '../web/src/lib/guide/render.js';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const args = process.argv.slice(2);
const updateEn = args[0] === '--update-en';
if (updateEn) args.shift();
const SITE = resolve(args[0] ?? join(ROOT, '..', 'ol1n.now'));
const I18N = join(ROOT, 'web/src/lib/guide/i18n');
const IMG_DIR = 'apps/ugcmarket/guide';

/** @param {string} p */
const readJson = (p) => JSON.parse(readFileSync(p, 'utf8'));

// English strings: page chrome (kept in en.json) + everything from guide.js
const enFile = join(I18N, 'en.json');
const en = readJson(enFile);
const page = Object.fromEntries(Object.entries(en).filter(([k]) => k.startsWith('_page.')));
const current = { ...page, ...guideStrings(GUIDE) };
if (JSON.stringify(current) !== JSON.stringify(en)) {
	if (!updateEn) {
		const changed = Object.keys({ ...current, ...en }).filter((k) => current[k] !== en[k]);
		console.error(`guide.js changed since en.json (${changed.join(', ')}).`);
		console.error('Run bin/export-olinnow --update-en, then update those keys in every i18n/<lang>.json.');
		process.exit(1);
	}
	writeFileSync(enFile, JSON.stringify(current, null, 1) + '\n');
	console.log('wrote en.json; update the changed keys in the translations');
}

// languages of the section and the site base language
const metaLangs = readFileSync(join(SITE, 'apps/ugcmarket/meta.md'), 'utf8').match(/^langs:\s*(.+)$/m);
const langs = metaLangs ? metaLangs[1].split(',').map((s) => s.trim()) : ['cs'];
const base = (readFileSync(join(SITE, 'scripts/i18n.sh'), 'utf8').match(/^I18N_BASE=(\S+)/m) ?? [])[1] ?? 'cs';

const pages = join(SITE, 'apps/ugcmarket/pages');
mkdirSync(pages, { recursive: true });
for (const f of readdirSync(pages)) if (/^guide(\.[\w-]+)?\.html$/.test(f)) rmSync(join(pages, f));

const used = new Set();
const missing = [];
for (const lang of langs) {
	const file = join(I18N, `${lang}.json`);
	if (lang !== 'en' && !existsSync(file)) {
		missing.push(lang);
		continue;
	}
	const tr = lang === 'en' ? current : readJson(file);
	const extra = Object.keys(tr).filter((k) => !(k in current));
	if (extra.length) throw new Error(`${lang}.json has keys guide.js no longer has: ${extra.join(', ')}`);
	const g = renderGuide(applyStrings(GUIDE, tr), { imgBase: `${IMG_DIR}/` });

	const one = (/** @type {string} */ s) => s.replace(/\s+/g, ' ').trim();
	const lead = GUIDE.studioVersion
		? inline(tr['_page.checked'].replace('{version}', GUIDE.studioVersion).replace('{date}', GUIDE.verifiedOn ?? '')) +
			' ' +
			inline(tr['_page.models']).replace('{link}', '<a href="https://market.ol1n.com">market.ol1n.com</a>')
		: '';
	// olin.now styles: reuse the subpage TOC and table look, the rest is scoped to .ugc-guide
	const toc = g.toc.replace(/^<ol class="toc">/, '<nav class="rules-toc">').replace(/<\/ol>$/, '</nav>').replace(/<\/?li>/g, '');
	const body = (toc + '\n' + g.body)
		.replaceAll('<table>', '<table class="rules-table">')
		.replace(/<a href="https:/g, '<a target="_blank" rel="noopener" href="https:')
		.replaceAll('</section>', '</section>\n');
	const html =
		'<!-- generated by RobloxMarket/bin/export-olinnow from web/src/lib/guide/guide.js; do not edit here -->\n' +
		`<!-- title: ${one(tr['_page.title'])} -->\n` +
		`<!-- intro: ${one(tr['_page.intro'])} -->\n` +
		(lead ? `<p class="lead">${lead}</p>\n` : '') +
		`<div class="ugc-guide">\n${body}</div>\n`;
	writeFileSync(join(pages, lang === base ? 'guide.html' : `guide.${lang}.html`), html);
	for (const m of html.matchAll(/apps\/ugcmarket\/guide\/([\w.-]+\.webp)/g)) used.add(m[1]);
}
if (missing.length) console.warn(`no translation yet (page not built): ${missing.join(', ')}`);
if (!langs.includes(base) || missing.includes(base)) throw new Error(`base language ${base} is missing`);

const out = join(SITE, 'static', IMG_DIR);
rmSync(out, { recursive: true, force: true });
mkdirSync(out, { recursive: true });
const src = join(ROOT, 'web/static/guide');
for (const f of readdirSync(src)) if (used.has(f)) copyFileSync(join(src, f), join(out, f));
console.log(`wrote ${langs.length - missing.length} pages to ${pages} and ${used.size} images to ${out}`);
