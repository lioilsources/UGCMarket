#!/usr/bin/env node
// Export the customer guide to the olin.now site (section `ugcmarket`, plan 02, stage 3b).
// Same source as /guide: web/src/lib/guide/guide.js rendered by render.js.
//
//   bin/export-olinnow [path/to/ol1n.now]   # default ../ol1n.now next to this repo
//
// Writes apps/ugcmarket/pages/guide.html (a body fragment, built into ugcmarket-guide.html)
// and copies the screenshots to static/apps/ugcmarket/guide/. Only verified sections go out.
import { copyFileSync, mkdirSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { GUIDE } from '../web/src/lib/guide/guide.js';
import { renderGuide } from '../web/src/lib/guide/render.js';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const SITE = resolve(process.argv[2] ?? join(ROOT, '..', 'ol1n.now'));
const IMG_DIR = 'apps/ugcmarket/guide';

const g = renderGuide(GUIDE, { imgBase: `${IMG_DIR}/` });
if (!g.complete) console.warn('warning: some sections are not verified and are left out');

const version = GUIDE.studioVersion
	? `<p class="lead">Checked in Roblox Studio ${GUIDE.studioVersion} on ${GUIDE.verifiedOn}. ` +
		'Models from <a href="https://market.ol1n.com">market.ol1n.com</a>.</p>\n'
	: '';
// olin.now styles: reuse the subpage TOC and table look, the rest is scoped to .ugc-guide.
const toc = g.toc.replace(/^<ol class="toc">/, '<nav class="rules-toc">').replace(/<\/ol>$/, '</nav>').replace(/<\/?li>/g, '');
const body = (toc + '\n' + g.body)
	.replaceAll('<table>', '<table class="rules-table">')
	.replace(/<a href="https:/g, '<a target="_blank" rel="noopener" href="https:');

const page =
	'<!-- generated by RobloxMarket/bin/export-olinnow from web/src/lib/guide/guide.js; do not edit here -->\n' +
	'<!-- title: Guide for Roblox Studio -->\n' +
	'<!-- intro: From the downloaded ZIP to an accessory on your character: import, texture, accessory and a short script, step by step with screenshots. -->\n' +
	version +
	`<div class="ugc-guide">\n${body.replaceAll('</section>', '</section>\n')}</div>\n`;

const pages = join(SITE, 'apps/ugcmarket/pages');
mkdirSync(pages, { recursive: true });
writeFileSync(join(pages, 'guide.html'), page);

const out = join(SITE, 'static', IMG_DIR);
rmSync(out, { recursive: true, force: true });
mkdirSync(out, { recursive: true });
const src = join(ROOT, 'web/static/guide');
const used = new Set([...page.matchAll(/apps\/ugcmarket\/guide\/([\w.-]+\.webp)/g)].map((m) => m[1]));
for (const f of readdirSync(src)) if (used.has(f)) copyFileSync(join(src, f), join(out, f));
console.log(`wrote ${join(pages, 'guide.html')} and ${used.size} images to ${out}`);
